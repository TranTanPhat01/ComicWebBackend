# ==============================================================================
# ComicWeb Backend Environment Configuration Template
# Copy this file to '.env' and populate with actual credentials before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & PORT SETTINGS
# ------------------------------------------------------------------------------
# Set ASPNETCORE_ENVIRONMENT to 'Production' for production deployments
ASPNETCORE_ENVIRONMENT=Production
# Configure the URL and Port ASP.NET Core will bind to
ASPNETCORE_URLS=http://+:8080

# ------------------------------------------------------------------------------
# DATABASE CONNECTION STRINGS
# ------------------------------------------------------------------------------
# Primary database connection (Read-Write). Treat this as a sensitive secret.
# Format: Host=<db_host>;Port=<db_port>;Database=<db_name>;Username=<db_user>;Password=<db_password>
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ComicWeb;Username=postgres;Password=your_strong_db_password_here

# Read-only Database replica connection (Optional. If left empty, fallback to DefaultConnection is used).
ConnectionStrings__ReadOnlyConnection=

# Redis server connection string (Optional. If left empty, application falls back to In-Memory local caching).
# Format: <host>:<port>,abortConnect=false
ConnectionStrings__RedisConnection=localhost:6379,abortConnect=false

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION OPTIONS
# ------------------------------------------------------------------------------
# The JWT Issuer (must match client validation)
Jwt__Issuer=ComicWeb
# The JWT Audience (must match client validation)
Jwt__Audience=ComicWebFrontend
# Secret key used for signing JWTs. Must be a cryptographically strong, random string.
# WARNING: Must be AT LEAST 32 characters (256 bits). Use a 64+ character string for production.
Jwt__SigningKey=your_random_cryptographically_secure_jwt_signing_key_of_at_least_32_chars_here
# Lifetime of the generated Access Token in minutes (1 - 60)
Jwt__AccessTokenMinutes=15

# ------------------------------------------------------------------------------
# BOOTSTRAP ADMINISTRATOR
# ------------------------------------------------------------------------------
# When Enabled is true, the application will seed this administrator on startup if they don't exist.
BootstrapAdmin__Enabled=true
BootstrapAdmin__Username=admin
BootstrapAdmin__Email=admin@gmail.com
# WARNING: Change this password to a strong value in production. 
# Do not reuse the development password 'Admin@Comic2026Strong'.
BootstrapAdmin__Password=your_secure_bootstrap_admin_password_here

# ------------------------------------------------------------------------------
# DATABASE MIGRATIONS
# ------------------------------------------------------------------------------
# If true, the system will apply any pending EF Core database migrations on startup.
DatabaseInitialization__ApplyMigrationsOnStartup=true
# Maximum migration retry attempts on startup
DatabaseInitialization__MaxRetryAttempts=10
# Retry delay seconds
DatabaseInitialization__RetryDelaySeconds=2

# ------------------------------------------------------------------------------
# SCHEDULED PUBLISHING WORKER
# ------------------------------------------------------------------------------
# Background worker configuration that automatically publishes scheduled chapters.
ScheduledPublishing__Enabled=true
ScheduledPublishing__IntervalSeconds=10
ScheduledPublishing__BatchSize=50

# ------------------------------------------------------------------------------
# CACHING AND PERFORMANCE (L1 Memory / L2 Redis)
# ------------------------------------------------------------------------------
# Enable or disable public reading caches
PublicCache__Enabled=true
# Time-To-Live configurations in seconds
PublicCache__StoryListTtlSeconds=30
PublicCache__StoryDetailTtlSeconds=60
PublicCache__ChapterListTtlSeconds=60
PublicCache__ChapterDetailTtlSeconds=120
# Maximum size of cached entry response in bytes (approx 1MB)
PublicCache__MaxEntrySizeBytes=1000000

# ------------------------------------------------------------------------------
# SECURITY HEADERS
# ------------------------------------------------------------------------------
# Allowed host headers (use comma-separated list like 'api.comicweb.com,admin.comicweb.com')
# '*' allows all hosts, which is fine for containerized environments behind load balancers.
AllowedHosts=*
