{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=ComicWeb;Username=postgres;Password=123456",
    "RedisConnection": "",
    "ReadOnlyConnection": ""
  },
  "Jwt": {
    "Issuer": "ComicWeb",
    "Audience": "ComicWebFrontend",
    "SigningKey": "ComicWeb-Development-JWT-Signing-Key-2026-At-Least-64-Characters-123456",
    "AccessTokenMinutes": 15
  },
  "BootstrapAdmin": {
    "Enabled": true,
    "Username": "admin",
    "Email": "admin@gmail.com",
    "Password": "Admin@Comic2026Strong"
  },
  "AuthenticationSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "LoginRequestsPerMinute": 5,
    "LoginRequestsPerHour": 20,
    "RefreshRequestsPerMinute": 10,
    "PublicReadingRequestsPerMinute": 60
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "MaxRetryAttempts": 5,
    "RetryDelaySeconds": 2
  },
  "ScheduledPublishing": {
    "IntervalSeconds": 60,
    "BatchSize": 20
  },
  "PublicCache": {
    "Enabled": false,
    "StoryListTtlSeconds": 30,
    "StoryDetailTtlSeconds": 120,
    "ChapterListTtlSeconds": 120,
    "ChapterDetailTtlSeconds": 600,
    "MaxEntrySizeBytes": 1000000
  },
  "Storage": {
    "Provider": "Local",
    "UploadsFolder": "wwwroot/uploads",
    "BaseUrl": "http://localhost:8080"
  },
  "AllowedHosts": "*"
}
